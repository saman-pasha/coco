;;;; The Coco -- crypto: SHA-256, and Bitcoin's double.
;;;;
;;;; A loadable Cicili module against cocolog's lib/sdk.cicili. It comes
;;;; in beside RIPEMD-160 rather than on its own account: `hash160' --
;;;; RIPEMD-160 over SHA-256 -- is what a Bitcoin address is made of, so
;;;; RIPEMD-160 without SHA-256 is a hash with nothing to hash.
;;;;
;;;;   sha256(+Text, -Hex)       sha256_hex(+HexIn, -Hex)
;;;;   sha256d_hex(+HexIn, -Hex) SHA-256 twice over, which is what
;;;;                             Bitcoin means by "the hash" of a block
;;;;                             header, a transaction or a merkle pair
;;;;
;;;; The constants are the definition -- fractional parts of the square
;;;; roots of the first eight primes and the cube roots of the first
;;;; sixty-four -- and were generated from it, not transcribed.

(DEFPARAMETER *sha256-predicates*
  '(("sha256"      2 s2_p_text)
    ("sha256_hex"  2 s2_p_hex)
    ("sha256d_hex" 2 s2_p_dhex)))

(source "sha256.c"
  (make :std #t :compile #f)

  (import "./sdk.cicili")
  (coco-sdk)
  (import "./lib-hex.cicili")
  (hex-core)
  (import "./lib-sha256.cicili")
  (sha256-core)

  (func s2_p_text ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (u8 dg [32]) (char hex [70]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "text or a code list" in)))
            (s2_hash (cast (const u8 *) buf) (strlen buf) dg)
            (hx_out dg 32 hex)
            (return (coco_m_unify_atom e out hex)))))

  (func s2_p_hex ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (u8 raw [32768]) (u8 dg [32]) (char hex [70]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "a hex atom" in)))
            (let ((i64 n . #'(hx_bytes buf raw 32768)))
              (if (< n 0) (return (coco_m_domain_error e "hexadecimal" in)))
              (s2_hash (cast (const u8 *) raw) (cast size_t n) dg)
              (hx_out dg 32 hex)
              (return (coco_m_unify_atom e out hex))))))

  ;;; Bitcoin never hashes once.
  (func s2_p_dhex ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (u8 raw [32768]) (u8 d1 [32]) (u8 d2 [32])
                (char hex [70]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "a hex atom" in)))
            (let ((i64 n . #'(hx_bytes buf raw 32768)))
              (if (< n 0) (return (coco_m_domain_error e "hexadecimal" in)))
              (s2_hash (cast (const u8 *) raw) (cast size_t n) d1)
              (s2_hash (cast (const u8 *) d1) 32 d2)
              (hx_out d2 32 hex)
              (return (coco_m_unify_atom e out hex))))))

  (static) (coco-emit-module-dispatch s2_dispatch *sha256-predicates*)
  (coco-deflibrary "sha256" s2_dispatch nil)

  ) ; source
