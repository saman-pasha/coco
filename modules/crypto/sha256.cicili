;;;; The Coco -- crypto: SHA-256, and Bitcoin's double.
;;;;
;;;; A loadable Cicili module against cocolog's lib/sdk.cicili. It comes
;;;; in beside RIPEMD-160 rather than on its own account: `hash160' --
;;;; RIPEMD-160 over SHA-256 -- is what a Bitcoin address is made of, so
;;;; RIPEMD-160 without SHA-256 is a hash with nothing to hash.
;;;;
;;;;   sha256(+Text, -Hex)       sha256_hex(+HexIn, -Hex)
;;;;   sha256d_hex(+HexIn, -Hex) SHA-256 twice over, which is what
;;;;                             Bitcoin means by "the hash" of a block
;;;;                             header, a transaction or a merkle pair
;;;;
;;;; The constants are the definition -- fractional parts of the square
;;;; roots of the first eight primes and the cube roots of the first
;;;; sixty-four -- and were generated from it, not transcribed.

(DEFPARAMETER *sha256-predicates*
  '(("sha256"      2 s2_p_text)
    ("sha256_hex"  2 s2_p_hex)
    ("sha256d_hex" 2 s2_p_dhex)))

(source "sha256.c"
  (make :std #t :compile #f)

  (import "./sdk.cicili")
  (coco-sdk)
  (import "./lib-hex.cicili")
  (hex-core)

  (static) (var u32 S2_H []
    . '{ 0x6a09e667 0xbb67ae85 0x3c6ef372 0xa54ff53a 0x510e527f 0x9b05688c 0x1f83d9ab 0x5be0cd19 })
  (static) (var u32 S2_K []
    . '{ 0x428a2f98 0x71374491 0xb5c0fbcf 0xe9b5dba5 0x3956c25b 0x59f111f1 0x923f82a4 0xab1c5ed5
         0xd807aa98 0x12835b01 0x243185be 0x550c7dc3 0x72be5d74 0x80deb1fe 0x9bdc06a7 0xc19bf174
         0xe49b69c1 0xefbe4786 0x0fc19dc6 0x240ca1cc 0x2de92c6f 0x4a7484aa 0x5cb0a9dc 0x76f988da
         0x983e5152 0xa831c66d 0xb00327c8 0xbf597fc7 0xc6e00bf3 0xd5a79147 0x06ca6351 0x14292967
         0x27b70a85 0x2e1b2138 0x4d2c6dfc 0x53380d13 0x650a7354 0x766a0abb 0x81c2c92e 0x92722c85
         0xa2bfe8a1 0xa81a664b 0xc24b8b70 0xc76c51a3 0xd192e819 0xd6990624 0xf40e3585 0x106aa070
         0x19a4c116 0x1e376c08 0x2748774c 0x34b0bcb5 0x391c0cb3 0x4ed8aa4a 0x5b9cca4f 0x682e6ff3
         0x748f82ee 0x78a5636f 0x84c87814 0x8cc70208 0x90befffa 0xa4506ceb 0xbef9a3f7 0xc67178f2 })

  (static) (func s2_rotr ((u32 x) (int n)) (out u32)
        (if (== (% n 32) 0) (return x))
        (return (bitor (>> x n) (<< x (- 32 n)))))

  (static) (func s2_block ((u32 * st) (const u8 * blk)) (out void)
        (let ((u32 w [64]) (u32 a . 0) (u32 b . 0) (u32 c . 0) (u32 d . 0)
              (u32 e . 0) (u32 f . 0) (u32 g . 0) (u32 hh . 0))
          (for ((int i . 0)) (< i 16) ((++ i))
            (set (nth i w)
                 (bitor (<< (cast u32 (nth (* i 4) blk)) 24)
                        (bitor (<< (cast u32 (nth (+ (* i 4) 1) blk)) 16)
                               (bitor (<< (cast u32 (nth (+ (* i 4) 2) blk)) 8)
                                      (cast u32 (nth (+ (* i 4) 3) blk)))))))
          (for ((int i . 16)) (< i 64) ((++ i))
            (let ((u32 s0 . #'(xor (s2_rotr (nth (- i 15) w) 7)
                                   (xor (s2_rotr (nth (- i 15) w) 18)
                                        (>> (nth (- i 15) w) 3))))
                  (u32 s1 . #'(xor (s2_rotr (nth (- i 2) w) 17)
                                   (xor (s2_rotr (nth (- i 2) w) 19)
                                        (>> (nth (- i 2) w) 10)))))
              (set (nth i w) (+ (+ s1 (nth (- i 7) w))
                                (+ s0 (nth (- i 16) w))))))
          (set a (nth 0 st)) (set b (nth 1 st)) (set c (nth 2 st)) (set d (nth 3 st))
          (set e (nth 4 st)) (set f (nth 5 st)) (set g (nth 6 st)) (set hh (nth 7 st))
          (for ((int i . 0)) (< i 64) ((++ i))
            (let ((u32 S1 . #'(xor (s2_rotr e 6) (xor (s2_rotr e 11) (s2_rotr e 25))))
                  (u32 ch . #'(xor (bitand e f) (bitand (xor e 0xffffffff) g)))
                  (u32 S0 . #'(xor (s2_rotr a 2) (xor (s2_rotr a 13) (s2_rotr a 22))))
                  (u32 mj . #'(xor (bitand a b) (xor (bitand a c) (bitand b c))))
                  (u32 t1 . 0) (u32 t2 . 0))
              (set t1 (+ (+ hh S1) (+ ch (+ (nth i S2_K) (nth i w)))))
              (set t2 (+ S0 mj))
              (set hh g) (set g f) (set f e) (set e (+ d t1))
              (set d c) (set c b) (set b a) (set a (+ t1 t2))))
          (set (nth 0 st) (+ (nth 0 st) a)) (set (nth 1 st) (+ (nth 1 st) b))
          (set (nth 2 st) (+ (nth 2 st) c)) (set (nth 3 st) (+ (nth 3 st) d))
          (set (nth 4 st) (+ (nth 4 st) e)) (set (nth 5 st) (+ (nth 5 st) f))
          (set (nth 6 st) (+ (nth 6 st) g)) (set (nth 7 st) (+ (nth 7 st) hh))))

  (static) (func s2_hash ((const u8 * in) (size_t len) (u8 * out)) (out void)
        (let ((u32 st [8]) (u8 tail [128]) (size_t done . 0) (size_t rest . 0)
              (size_t tl . 0))
          (for ((int i . 0)) (< i 8) ((++ i)) (set (nth i st) (nth i S2_H)))
          (while (>= (- len done) 64)
            (s2_block st (aof (nth done in)))
            (set done (+ done 64)))
          (set rest (- len done))
          (for ((int i . 0)) (< i 128) ((++ i)) (set (nth i tail) 0))
          (for ((size_t i . 0)) (< i rest) ((++ i))
            (set (nth i tail) (nth (+ done i) in)))
          (set (nth rest tail) 0x80)
          (set tl (? (< rest 56) 64 128))
          (let ((u64 bits . #'(* (cast u64 len) 8)))
            (for ((int j . 0)) (< j 8) ((++ j))
              (set (nth (- (- tl 1) j) tail)
                   (cast u8 (bitand (>> bits (* 8 j)) 255)))))
          (s2_block st tail)
          (if (== tl 128) (s2_block st (aof (nth 64 tail))))
          (for ((int i . 0)) (< i 8) ((++ i))
            (for ((int j . 0)) (< j 4) ((++ j))
              (set (nth (+ (* i 4) j) out)
                   (cast u8 (bitand (>> (nth i st) (* 8 (- 3 j))) 255)))))))

  (func s2_p_text ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (u8 dg [32]) (char hex [70]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "text or a code list" in)))
            (s2_hash (cast (const u8 *) buf) (strlen buf) dg)
            (hx_out dg 32 hex)
            (return (coco_m_unify_atom e out hex)))))

  (func s2_p_hex ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (u8 raw [32768]) (u8 dg [32]) (char hex [70]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "a hex atom" in)))
            (let ((i64 n . #'(hx_bytes buf raw 32768)))
              (if (< n 0) (return (coco_m_domain_error e "hexadecimal" in)))
              (s2_hash (cast (const u8 *) raw) (cast size_t n) dg)
              (hx_out dg 32 hex)
              (return (coco_m_unify_atom e out hex))))))

  ;;; Bitcoin never hashes once.
  (func s2_p_dhex ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (u8 raw [32768]) (u8 d1 [32]) (u8 d2 [32])
                (char hex [70]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "a hex atom" in)))
            (let ((i64 n . #'(hx_bytes buf raw 32768)))
              (if (< n 0) (return (coco_m_domain_error e "hexadecimal" in)))
              (s2_hash (cast (const u8 *) raw) (cast size_t n) d1)
              (s2_hash (cast (const u8 *) d1) 32 d2)
              (hx_out d2 32 hex)
              (return (coco_m_unify_atom e out hex))))))

  (static) (coco-emit-module-dispatch s2_dispatch *sha256-predicates*)
  (coco-deflibrary "sha256" s2_dispatch nil)

  ) ; source
