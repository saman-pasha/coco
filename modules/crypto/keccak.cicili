;;;; The Coco -- crypto: Keccak-256, the hash behind every EVM chain.
;;;;
;;;; A loadable Cicili module: written against cocolog's lib/sdk.cicili
;;;; (symlinked beside this file by build.sh), transpiled to keccak.c,
;;;; compiled to keccak.so, and reached by `use_module(library(keccak))'
;;;; once keccak.so is on $COCOLOG_LIBRARY. No cocolog source is
;;;; touched; the module is The Coco's own.
;;;;
;;;; THIS IS KECCAK, NOT SHA3. Ethereum standardised on the original
;;;; Keccak submission, whose domain-separation byte is 0x01 -- NIST's
;;;; finalised SHA3-256 uses 0x06 and produces a DIFFERENT digest for
;;;; the same input. keccak256("") is the well-known
;;;; c5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470,
;;;; and test/crypto.sh holds this and "abc" to the published vectors.
;;;;
;;;; Two predicates:
;;;;   keccak256(+Text, -Hex)      hashes the BYTES of Text -- an atom,
;;;;                               an integer, or a code list, whatever
;;;;                               coco_m_text reads.
;;;;   keccak256_hex(+HexIn, -Hex) decodes HexIn from hexadecimal FIRST
;;;;                               and hashes those bytes -- the one a
;;;;                               chain wants, because an RLP-encoded
;;;;                               transaction is arbitrary bytes,
;;;;                               zero bytes included, which a code
;;;;                               list cannot carry (code 0 is refused).
;;;; Hex is a lowercase 64-character hex atom either way.

(DEFPARAMETER *keccak-predicates*
  '(("keccak256"     2 kc_keccak256)
    ("keccak256_hex" 2 kc_keccak256_hex)))

(source "keccak.c"
  (make :std #t :compile #f)

  (import "./sdk.cicili")
  (coco-sdk)

  ;;; ---- the permutation ------------------------------------------------

  ;;; Keccak-f[1600] round constants and the rho/pi rotation and lane
  ;;; tables, the standard values. The round constants above 2^63 are
  ;;; unsigned by construction, which C reads correctly for a u64 array.
  (static) (var u64 KC_RC []
    . '{ 0x0000000000000001 0x0000000000008082 0x800000000000808a 0x8000000080008000
         0x000000000000808b 0x0000000080000001 0x8000000080008081 0x8000000000008009
         0x000000000000008a 0x0000000000000088 0x0000000080008009 0x000000008000000a
         0x000000008000808b 0x800000000000008b 0x8000000000008089 0x8000000000008003
         0x8000000000008002 0x8000000000000080 0x000000000000800a 0x800000008000000a
         0x8000000080008081 0x8000000000008080 0x0000000080000001 0x8000000080008008 })

  (static) (var int KC_ROT []
    . '{ 1 3 6 10 15 21 28 36 45 55 2 14 27 41 56 8 25 43 62 18 39 61 20 44 })

  (static) (var int KC_PI []
    . '{ 10 7 11 17 18 3 5 16 8 21 24 4 15 23 19 13 12 2 20 14 22 9 6 1 })

  ;;; A left rotation, guarded at zero so the >> is never by 64 (undefined).
  (static)
  (func kc_rotl ((u64 x) (int n)) (out u64)
        (if (== (% n 64) 0) (return x))
        (return (bitor (<< x n) (>> x (- 64 n)))))

  ;;; Twenty-four rounds over the 25-lane state, in place.
  (static)
  (func kc_f ((u64 * st)) (out void)
        (let ((u64 bc [5]) (u64 t . 0))
          (for ((int r . 0)) (< r 24) ((++ r))
            ;; theta
            (for ((int i . 0)) (< i 5) ((++ i))
              (set (nth i bc)
                   (xor (nth i st)
                        (xor (nth (+ i 5) st)
                             (xor (nth (+ i 10) st)
                                  (xor (nth (+ i 15) st) (nth (+ i 20) st)))))))
            (for ((int i . 0)) (< i 5) ((++ i))
              (set t (xor (nth (% (+ i 4) 5) bc) (kc_rotl (nth (% (+ i 1) 5) bc) 1)))
              (for ((int j . 0)) (< j 25) ((set j (+ j 5)))
                (set (nth (+ j i) st) (xor (nth (+ j i) st) t))))
            ;; rho and pi
            (set t (nth 1 st))
            (for ((int i . 0)) (< i 24) ((++ i))
              (let ((int j . #'(nth i KC_PI)))
                (set (nth 0 bc) (nth j st))
                (set (nth j st) (kc_rotl t (nth i KC_ROT)))
                (set t (nth 0 bc))))
            ;; chi
            (for ((int j . 0)) (< j 25) ((set j (+ j 5)))
              (for ((int i . 0)) (< i 5) ((++ i))
                (set (nth i bc) (nth (+ j i) st)))
              (for ((int i . 0)) (< i 5) ((++ i))
                (set (nth (+ j i) st)
                     (xor (nth (+ j i) st)
                          (bitand (xor (nth (% (+ i 1) 5) bc) 0xffffffffffffffff)
                                  (nth (% (+ i 2) 5) bc))))))
            ;; iota
            (set (nth 0 st) (xor (nth 0 st) (nth r KC_RC))))))

  ;;; ---- the sponge -----------------------------------------------------

  ;;; keccak256 of LEN bytes at IN, the 64-char lowercase hex into HEX
  ;;; (which must hold 65 bytes). Rate 136 bytes, capacity 512, Keccak
  ;;; padding 0x01 .. 0x80 -- the two padding bytes collapse into 0x81
  ;;; when the message ends one byte short of a block, which the two
  ;;; XORs below do without a special case.
  (static)
  (func kc_hash ((const u8 * in) (size_t len) (char * hex)) (out void)
        (let ((u64 st [25]) (size_t pt . 0) (size_t rate . 136)
              (const char * hx . "0123456789abcdef"))
          (memset (cast (void *) (aof (nth 0 st))) 0 (* 25 (sizeof u64)))
          ;; absorb
          (for ((size_t k . 0)) (< k len) ((++ k))
            (let ((size_t lane . #'(>> pt 3))
                  (int sh . #'(* 8 (cast int (bitand pt 7)))))
              (set (nth lane st)
                   (xor (nth lane st) (<< (cast u64 (nth k in)) sh))))
            (set pt (+ pt 1))
            (if (== pt rate) (block (kc_f (aof (nth 0 st))) (set pt 0))))
          ;; pad: 0x01 at the message end, 0x80 at the block end
          (let ((size_t lane . #'(>> pt 3))
                (int sh . #'(* 8 (cast int (bitand pt 7)))))
            (set (nth lane st) (xor (nth lane st) (<< (cast u64 1) sh))))
          (let ((size_t last . #'(- rate 1))
                (size_t lane . #'(>> (- rate 1) 3))
                (int sh . #'(* 8 (cast int (bitand (- rate 1) 7)))))
            (cast void last)
            (set (nth lane st) (xor (nth lane st) (<< (cast u64 0x80) sh))))
          (kc_f (aof (nth 0 st)))
          ;; squeeze 32 bytes, little-endian out of the lanes, to hex
          (for ((int i . 0)) (< i 32) ((++ i))
            (let ((int b . #'(bitand (cast int (>> (nth (>> i 3) st)
                                                   (* 8 (bitand i 7))))
                                     255)))
              (set (nth (* 2 i) hex) (nth (bitand (>> b 4) 15) hx))
              (set (nth (+ (* 2 i) 1) hex) (nth (bitand b 15) hx))))
          (set (nth 64 hex) (cast char 0))))

  ;;; ---- hex input ------------------------------------------------------

  ;;; A hex nibble's value, or -1. `0x' prefix is skipped by the caller.
  (static)
  (func kc_nib ((char c)) (out int)
        (if (and (>= c (cast char 48)) (<= c (cast char 57)))   ;; '0'..'9'
            (return (- (cast int c) 48)))
        (if (and (>= c (cast char 97)) (<= c (cast char 102)))  ;; 'a'..'f'
            (return (+ 10 (- (cast int c) 97))))
        (if (and (>= c (cast char 65)) (<= c (cast char 70)))   ;; 'A'..'F'
            (return (+ 10 (- (cast int c) 65))))
        (return -1))

  ;;; Decodes SRC (an even number of hex digits, optional `0x') into OUT,
  ;;; answering the byte count or -1 for a malformed string.
  (static)
  (func kc_unhex ((const char * src) (u8 * out) (size_t cap)) (out i64)
        (let ((size_t i . 0) (size_t n . 0))
          (if (and (== (nth 0 src) (cast char 48))
                   (or (== (nth 1 src) (cast char 120))     ;; 'x'
                       (== (nth 1 src) (cast char 88))))    ;; 'X'
              (set i 2))
          (while (!= (nth i src) (cast char 0))
            (let ((int hi . #'(kc_nib (nth i src))))
              (if (< hi 0) (return -1))
              (if (== (nth (+ i 1) src) (cast char 0)) (return -1))
              (let ((int lo . #'(kc_nib (nth (+ i 1) src))))
                (if (< lo 0) (return -1))
                (if (>= n cap) (return -1))
                (set (nth n out) (cast u8 (bitor (<< hi 4) lo)))
                (set n (+ n 1))
                (set i (+ i 2)))))
          (return (cast i64 n))))

  ;;; ---- the predicates -------------------------------------------------

  ;;; The input cap: a chain header or a modest transaction, not a block
  ;;; body. Streaming is a later concern; the vectors and the aggregator's
  ;;; first proofs sit far under this.

  (func kc_keccak256 ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (char hex [65]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "text or a code list" in)))
            (kc_hash (cast (const u8 *) buf) (strlen buf) hex)
            (return (coco_m_unify_atom e out hex)))))

  (func kc_keccak256_hex ((coco_engine * e) (size_t g)) (out int)
        (coco-mod-args e g ((in 0) (out 1))
          (let ((char buf [65536]) (u8 raw [65536]) (char hex [65]))
            (if (not (coco_m_text e in buf 65536))
                (return (coco_m_type_error e "a hex atom" in)))
            (let ((i64 n . #'(kc_unhex buf raw 65536)))
              (if (< n 0) (return (coco_m_domain_error e "hexadecimal" in)))
              (kc_hash (cast (const u8 *) raw) (cast size_t n) hex)
              (return (coco_m_unify_atom e out hex))))))

  (static) (coco-emit-module-dispatch kc_dispatch *keccak-predicates*)
  (coco-deflibrary "keccak" kc_dispatch nil)

  ) ; source
