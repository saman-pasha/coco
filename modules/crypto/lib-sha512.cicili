;;;; SHA-512, as a core two modules share.
;;;;
;;;; This file is not a module: it is imported by one, and the module's
;;;; body says `(sha512-core)' where the functions should go -- the same
;;;; arrangement cocolog's lib/*.cicili have with the target that
;;;; instantiates them. `library(sha512)' exposes it as predicates;
;;;; `library(ed25519)' needs it INSIDE, because the challenge scalar of
;;;; an Ed25519 signature is a SHA-512 over three concatenated things
;;;; and no Prolog round trip belongs in the middle of that.
;;;;
;;;; The constants are the definition -- the fractional parts of the
;;;; square roots of the first eight primes, and of the cube roots of
;;;; the first eighty -- and were generated from it rather than copied
;;;; out of a table, which is the only way to be sure of eighty-eight
;;;; sixteen-digit numbers.

(DEFMACRO sha512-core ()
  '($$$

  (static) (var u64 SH_H []
    . '{ 0x6a09e667f3bcc908 0xbb67ae8584caa73b 0x3c6ef372fe94f82b 0xa54ff53a5f1d36f1
         0x510e527fade682d1 0x9b05688c2b3e6c1f 0x1f83d9abfb41bd6b 0x5be0cd19137e2179 })

  (static) (var u64 SH_K []
    . '{ 0x428a2f98d728ae22 0x7137449123ef65cd 0xb5c0fbcfec4d3b2f 0xe9b5dba58189dbbc
         0x3956c25bf348b538 0x59f111f1b605d019 0x923f82a4af194f9b 0xab1c5ed5da6d8118
         0xd807aa98a3030242 0x12835b0145706fbe 0x243185be4ee4b28c 0x550c7dc3d5ffb4e2
         0x72be5d74f27b896f 0x80deb1fe3b1696b1 0x9bdc06a725c71235 0xc19bf174cf692694
         0xe49b69c19ef14ad2 0xefbe4786384f25e3 0x0fc19dc68b8cd5b5 0x240ca1cc77ac9c65
         0x2de92c6f592b0275 0x4a7484aa6ea6e483 0x5cb0a9dcbd41fbd4 0x76f988da831153b5
         0x983e5152ee66dfab 0xa831c66d2db43210 0xb00327c898fb213f 0xbf597fc7beef0ee4
         0xc6e00bf33da88fc2 0xd5a79147930aa725 0x06ca6351e003826f 0x142929670a0e6e70
         0x27b70a8546d22ffc 0x2e1b21385c26c926 0x4d2c6dfc5ac42aed 0x53380d139d95b3df
         0x650a73548baf63de 0x766a0abb3c77b2a8 0x81c2c92e47edaee6 0x92722c851482353b
         0xa2bfe8a14cf10364 0xa81a664bbc423001 0xc24b8b70d0f89791 0xc76c51a30654be30
         0xd192e819d6ef5218 0xd69906245565a910 0xf40e35855771202a 0x106aa07032bbd1b8
         0x19a4c116b8d2d0c8 0x1e376c085141ab53 0x2748774cdf8eeb99 0x34b0bcb5e19b48a8
         0x391c0cb3c5c95a63 0x4ed8aa4ae3418acb 0x5b9cca4f7763e373 0x682e6ff3d6b2b8a3
         0x748f82ee5defb2fc 0x78a5636f43172f60 0x84c87814a1f0ab72 0x8cc702081a6439ec
         0x90befffa23631e28 0xa4506cebde82bde9 0xbef9a3f7b2c67915 0xc67178f2e372532b
         0xca273eceea26619c 0xd186b8c721c0c207 0xeada7dd6cde0eb1e 0xf57d4f7fee6ed178
         0x06f067aa72176fba 0x0a637dc5a2c898a6 0x113f9804bef90dae 0x1b710b35131c471b
         0x28db77f523047d84 0x32caab7b40c72493 0x3c9ebe0a15c9bebc 0x431d67c49c100d4c
         0x4cc5d4becb3e42b6 0x597f299cfc657e2a 0x5fcb6fab3ad6faec 0x6c44198c4a475817 })

  (static) (func sh_rotr ((u64 x) (int n)) (out u64)
        (if (== (% n 64) 0) (return x))
        (return (bitor (>> x n) (<< x (- 64 n)))))

  ;;; One 128-byte block into the eight-word state.
  (static) (func sh_block ((u64 * st) (const u8 * blk)) (out void)
        (let ((u64 w [80]) (u64 a . 0) (u64 b . 0) (u64 c . 0) (u64 d . 0)
              (u64 e . 0) (u64 f . 0) (u64 g . 0) (u64 hh . 0))
          (for ((int i . 0)) (< i 16) ((++ i))
            (let ((u64 v . 0))
              (for ((int j . 0)) (< j 8) ((++ j))
                (set v (bitor (<< v 8) (cast u64 (nth (+ (* i 8) j) blk)))))
              (set (nth i w) v)))
          (for ((int i . 16)) (< i 80) ((++ i))
            (let ((u64 s0 . #'(xor (sh_rotr (nth (- i 15) w) 1)
                                   (xor (sh_rotr (nth (- i 15) w) 8)
                                        (>> (nth (- i 15) w) 7))))
                  (u64 s1 . #'(xor (sh_rotr (nth (- i 2) w) 19)
                                   (xor (sh_rotr (nth (- i 2) w) 61)
                                        (>> (nth (- i 2) w) 6)))))
              (set (nth i w) (+ (+ s1 (nth (- i 7) w))
                                (+ s0 (nth (- i 16) w))))))
          (set a (nth 0 st)) (set b (nth 1 st)) (set c (nth 2 st)) (set d (nth 3 st))
          (set e (nth 4 st)) (set f (nth 5 st)) (set g (nth 6 st)) (set hh (nth 7 st))
          (for ((int i . 0)) (< i 80) ((++ i))
            (let ((u64 S1 . #'(xor (sh_rotr e 14) (xor (sh_rotr e 18) (sh_rotr e 41))))
                  (u64 ch . #'(xor (bitand e f) (bitand (xor e 0xffffffffffffffff) g)))
                  (u64 S0 . #'(xor (sh_rotr a 28) (xor (sh_rotr a 34) (sh_rotr a 39))))
                  (u64 mj . #'(xor (bitand a b) (xor (bitand a c) (bitand b c))))
                  (u64 t1 . 0) (u64 t2 . 0))
              (set t1 (+ (+ hh S1) (+ ch (+ (nth i SH_K) (nth i w)))))
              (set t2 (+ S0 mj))
              (set hh g) (set g f) (set f e) (set e (+ d t1))
              (set d c) (set c b) (set b a) (set a (+ t1 t2))))
          (set (nth 0 st) (+ (nth 0 st) a)) (set (nth 1 st) (+ (nth 1 st) b))
          (set (nth 2 st) (+ (nth 2 st) c)) (set (nth 3 st) (+ (nth 3 st) d))
          (set (nth 4 st) (+ (nth 4 st) e)) (set (nth 5 st) (+ (nth 5 st) f))
          (set (nth 6 st) (+ (nth 6 st) g)) (set (nth 7 st) (+ (nth 7 st) hh))))

  ;;; LEN bytes at IN, sixty-four bytes of digest at OUT. The whole
  ;;; blocks go straight from IN; only the tail is copied, padded with
  ;;; the 0x80 and the big-endian bit length, and run through last.
  (static) (func sh512 ((const u8 * in) (size_t len) (u8 * out)) (out void)
        (let ((u64 st [8]) (u8 tail [256]) (size_t full . 0) (size_t rest . 0)
              (size_t tl . 0))
          (for ((int i . 0)) (< i 8) ((++ i)) (set (nth i st) (nth i SH_H)))
          (set full (/ len 128))
          (set rest (- len (* full 128)))
          (for ((size_t b . 0)) (< b full) ((++ b))
            (sh_block st (aof (nth (* b 128) in))))
          (for ((int i . 0)) (< i 256) ((++ i)) (set (nth i tail) 0))
          (for ((size_t i . 0)) (< i rest) ((++ i))
            (set (nth i tail) (nth (+ (* full 128) i) in)))
          (set (nth rest tail) 0x80)
          (set tl (? (< rest 112) 128 256))
          (let ((u64 bits . #'(* (cast u64 len) 8)))
            (for ((int j . 0)) (< j 8) ((++ j))
              (set (nth (- (- tl 1) j) tail)
                   (cast u8 (bitand (>> bits (* 8 j)) 255)))))
          (sh_block st tail)
          (if (== tl 256) (sh_block st (aof (nth 128 tail))))
          (for ((int i . 0)) (< i 8) ((++ i))
            (for ((int j . 0)) (< j 8) ((++ j))
              (set (nth (+ (* i 8) j) out)
                   (cast u8 (bitand (>> (nth i st) (* 8 (- 7 j))) 255)))))))

  ))
