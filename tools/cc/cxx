#!/bin/sh
# The C++ compiler this repository builds with, plus the one flag Ubuntu
# makes necessary. See ./README for the whole story; the short version is
# that clang picks the NEWEST gcc it can find to borrow libstdc++ from,
# and on Ubuntu 24.04 that is gcc-14's runtime directory -- which ships no
# C++ headers at all. Every C++ file then dies at
#
#     fatal error: 'string' file not found
#
# naming a header that is plainly installed. So: pick the newest gcc
# install dir that actually HAS a header set, and say so.
#
# IT IS COMPUTED, NOT WRITTEN DOWN. A hardcoded 13 is a build that breaks
# on the next machine, and this cost an afternoon once already.
cxx=${CICILI_CXX:-clang++}
# The same Darwin rule ./cc carries: a shared object may leave the
# interpreter's symbols to load time.
extra=
case "$(uname -s)" in
  Darwin)
    # ...and not only for a shared object. A program that links only the
    # client archive leaves the TLS entry points and the embedded engine's
    # UNDEFINED on purpose -- `weak' on Linux, `weak_import' here -- and
    # Mach-O's weak_import still wants a definition at LINK time; only
    # dynamic lookup lets the reference stay open and bind to null at load,
    # which is the Linux behaviour every caller of those symbols checks for.
    # So every link step on Darwin (anything not a `-c' compile) gets it.
    link=1; for a in "$@"; do [ "$a" = -c ] && link=0; done
    [ $link = 1 ] && extra="-Wl,-undefined,dynamic_lookup" ;;
esac
case "$cxx" in
  *clang*)
    if [ -z "$CICILI_GCC_DIR" ]; then
      for d in $(ls -1d /usr/lib/gcc/*/[0-9]* 2>/dev/null | sort -Vr); do
        if [ -d "/usr/include/c++/${d##*/}" ]; then CICILI_GCC_DIR=$d; break; fi
      done
    fi
    if [ -n "$CICILI_GCC_DIR" ]; then
      exec "$cxx" $extra "--gcc-install-dir=$CICILI_GCC_DIR" "$@"
    fi
    ;;
esac
exec "$cxx" $extra "$@"
